# -*- coding: utf-8 -*-
"""
DoDHooks PackageScript
Copies extension + gamedata + include into the package directory
"""

import os
import shutil

def package(builder):
    """Package the extension for distribution"""

    build_path = builder.build_path
    pkg_path = os.path.join(build_path, 'package')

    # Create package directory structure
    dirs = [
        os.path.join(pkg_path, 'addons', 'sourcemod', 'extensions'),
        os.path.join(pkg_path, 'addons', 'sourcemod', 'gamedata'),
        os.path.join(pkg_path, 'addons', 'sourcemod', 'scripting', 'include'),
        os.path.join(pkg_path, 'addons', 'sourcemod', 'scripting'),
        os.path.join(pkg_path, 'addons', 'sourcemod', 'translations'),
    ]

    for d in dirs:
        os.makedirs(d, exist_ok=True)

    # Copy extension binary
    ext_name = builder.get_project('dodhooks.ext').output_file
    ext_src = os.path.join(build_path, ext_name)

    if os.path.exists(ext_src):
        ext_dst = os.path.join(pkg_path, 'addons', 'sourcemod', 'extensions', ext_name)
        shutil.copy2(ext_src, ext_dst)
        print(f"  📦 Copied {ext_name}")

    # Copy gamedata
    gamedata_src = os.path.join(builder.source_path, 'sourcemod', 'gamedata', 'dodhooks.txt')
    if os.path.exists(gamedata_src):
        gamedata_dst = os.path.join(pkg_path, 'addons', 'sourcemod', 'gamedata', 'dodhooks.txt')
        shutil.copy2(gamedata_src, gamedata_dst)
        print("  📦 Copied dodhooks.txt (gamedata)")

    # Copy include file
    inc_src = os.path.join(builder.source_path, 'sourcemod', 'scripting', 'include', 'dodhooks.inc')
    if os.path.exists(inc_src):
        inc_dst = os.path.join(pkg_path, 'addons', 'sourcemod', 'scripting', 'include', 'dodhooks.inc')
        shutil.copy2(inc_src, inc_dst)
        print("  📦 Copied dodhooks.inc")

    # Copy example plugin
    ex_src = os.path.join(builder.source_path, 'sourcemod', 'scripting', 'dodhooks_example.sp')
    if os.path.exists(ex_src):
        ex_dst = os.path.join(pkg_path, 'addons', 'sourcemod', 'scripting', 'dodhooks_example.sp')
        shutil.copy2(ex_src, ex_dst)
        print("  📦 Copied dodhooks_example.sp")

    # Copy translations
    trans_src = os.path.join(builder.source_path, 'sourcemod', 'translations')
    if os.path.isdir(trans_src):
        for f in os.listdir(trans_src):
            if f.endswith('.txt'):
                shutil.copy2(os.path.join(trans_src, f),
                             os.path.join(pkg_path, 'addons', 'sourcemod', 'translations', f))
                print(f"  📦 Copied {f}")

    print(f"\n✅ Package ready at: {pkg_path}")
