# -*- coding: utf-8 -*-
"""
DoDHooks AMBuilder
Called by AMBuild to compile the extension
"""

from ambuild2 import util
import os

def build(builder):
    """Main build function called by AMBuild"""

    # Get project from AMBuildScript
    project = builder.get_project('dodhooks.ext')

    # Compile each source file
    objects = []
    for src in project.sources:
        obj = builder.compile_cpp(
            source=src,
            includes=project.includes,
            defines=project.defines,
            cpp_std=project.cpp_std,
        )
        objects.append(obj)

    # Link into shared library
    output = builder.link_shared(
        output=project.output_file,
        inputs=objects,
        libs=project.libs,
    )

    # Install to package directory
    pkg_dir = os.path.join(builder.build_path, 'package')
    builder.install(output, pkg_dir)

    return output
