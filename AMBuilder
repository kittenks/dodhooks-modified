# vim: set sts=2 ts=8 sw=2 tw=99 et ft=python:
"""
DODHooks - AMBuilder

Defines the source files and build targets for the extension.
Supports both 32-bit and 64-bit builds.
"""

import os

projectName = 'dodhooks'

# smsdk_ext.cpp is automatically added by the build system in SM 1.12+
sourceFiles = [
    'extension.cpp',
    'natives.cpp',
    'vglobals.cpp',
    '../sourcemod/public/CDetour/detours.cpp',
    '../sourcemod/public/asm/asm.c',
    '../sourcemod/public/libudis86/decode.c',
    '../sourcemod/public/libudis86/itab.c',
    '../sourcemod/public/libudis86/syn-att.c',
    '../sourcemod/public/libudis86/syn-intel.c',
    '../sourcemod/public/libudis86/syn.c',
    '../sourcemod/public/libudis86/udis86.c',
]

# ---------------------------------------------------------------------------
# Create the project
# ---------------------------------------------------------------------------
project = DODHooks.HL2Project(builder, projectName + '.ext')

# Add source files
project.sources += sourceFiles

# ---------------------------------------------------------------------------
# Create a binary for each supported SDK
# ---------------------------------------------------------------------------
# Be defensive: older configure paths or missing configuration may leave
# DODHooks.sdks undefined. Build a fallback from builder.options.sdks
# (comma-separated) or default to a single 'dod' SDK so CI doesn't crash
# with an AttributeError.
sdks = getattr(DODHooks, 'sdks', None)
if not sdks:
    sdks = {}
    # builder.options.sdks may be provided by external scripts as a comma-separated
    # list (e.g. --sdks=dod). If present, build minimal SDK objects with an
    # 'ext' attribute used below.
    sdks_opt = getattr(builder.options, 'sdks', None)
    if sdks_opt:
        for name in str(sdks_opt).split(','):
            name = name.strip()
            if not name:
                continue
            class _SDK:
                pass
            s = _SDK()
            s.ext = name
            sdks[name] = s
    else:
        class _SDK:
            pass
        s = _SDK()
        s.ext = 'dod'
        sdks['dod'] = s

# Ensure extensions list exists on the DODHooks object
if not hasattr(DODHooks, 'extensions'):
    DODHooks.extensions = []

for sdk_name in sdks:
    sdk = sdks[sdk_name]

    # The binary name follows the pattern: dodhooks.ext.<sdk>.<arch>
    binary_name = '{0}.ext.{1}'.format(projectName, sdk.ext)
    if builder.cxx.target.arch == 'x86_64':
        binary_name += '.x64'

    binary = DODHooks.HL2Config(project, builder.cxx, binary_name)
    DODHooks.extensions.append(binary)

# Export for PackageScript
Extension = DODHooks
