# AMBuilder - 定义构建规则和文件复制
# 此文件由 AMBuild 在构建阶段自动加载

import os

def build(builder):
    """AMBuild 主构建函数"""

    # 项目信息
    project = builder.options.project
    target = builder.options.target

    # 复制 gamedata 文件到产物目录
    gamedata_src = os.path.join(builder.source_path, 'sourcemod', 'gamedata', 'dodhooks.txt')
    gamedata_dst = os.path.join(builder.build_path, 'package', 'gamedata', 'dodhooks.txt')
    if os.path.exists(gamedata_src):
        builder.AddCopy(gamedata_src, gamedata_dst)

    # 复制 include 文件
    include_src = os.path.join(builder.source_path, 'sourcemod', 'include', 'dodhooks.inc')
    include_dst = os.path.join(builder.build_path, 'package', 'include', 'dodhooks.inc')
    if os.path.exists(include_src):
        builder.AddCopy(include_src, include_dst)

    # 复制示例插件
    example_src = os.path.join(builder.source_path, 'sourcemod', 'plugins', 'dodhooks_example.sp')
    example_dst = os.path.join(builder.build_path, 'package', 'plugins', 'dodhooks_example.sp')
    if os.path.exists(example_src):
        builder.AddCopy(example_src, example_dst)

    # 复制 autoload 配置
    autoload_src = os.path.join(builder.source_path, 'sourcemod', 'configs', 'dodhooks.autoload')
    autoload_dst = os.path.join(builder.build_path, 'package', 'configs', 'dodhooks.autoload')
    if os.path.exists(autoload_src):
        builder.AddCopy(autoload_src, autoload_dst)
