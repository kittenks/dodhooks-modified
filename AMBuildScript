"""
DoDHooks - AMBuildScript
AMBuild 2.2 / SourceMod 1.12 extension build script
"""

from ambuild2 import Extension
import os

# Project meta
projectName = "dodhooks"
projectVersion = "2.0.0"

# Path helpers
def GetSDKPath(builder, sdkName):
    """Resolve SDK path from builder options."""
    root = builder.options.get('hl2sdk_root')
    if root:
        return os.path.join(root, 'hl2sdk-' + sdkName)
    return None

def GetPlatform(builder):
    if builder.target_platform == 'windows':
        return 'win'
    elif builder.target_platform == 'linux':
        return 'linux'
    return 'unknown'

def GetArch(builder):
    if builder.target_arch == 'x86_64':
        return 'x64'
    return 'x86'

def build(builder):
    platform = GetPlatform(builder)
    arch = GetArch(builder)

    print("[DoDHooks] Building for {}-{}".format(platform, arch))

    # Create HL2 extension project
    # Extension.HL2Project handles SM/MM/hl2sdk include paths and linking
    project = Extension.HL2Project(builder, projectName + '.ext')

    # Compiler flags
    if builder.target_platform == 'linux':
        project.cxx.flags += [
            '-fPIC',
            '-Wall',
            '-Wno-unknown-pragmas',
            '-Wno-unused-function',
            '-Wno-sign-compare',
            '-Wno-unused-variable',
        ]
        project.cxx.defines += ['LINUX', 'POSIX']
    else:
        project.cxx.flags += [
            '/W3',
            '/MP',
            '/wd4996',
            '/wd4267',
            '/wd4244',
        ]
        project.cxx.defines += ['WIN32', 'WINDOWS']

    # Optimization
    if builder.options.get('enable-optimize'):
        if builder.target_platform == 'linux':
            project.cxx.flags += ['-O2']
        else:
            project.cxx.flags += ['/O2']

    # Debug info
    if builder.options.get('enable-debug'):
        if builder.target_platform == 'linux':
            project.cxx.flags += ['-g']
        else:
            project.cxx.flags += ['/Zi']

    # Source files (relative to this AMBuildScript)
    sources = [
        'extension.cpp',
        'natives.cpp',
        'vglobals.cpp',
    ]
    for s in sources:
        project.sources.append(s)

    # Add the project to the build
    builder.Add(project)

# Backward compatibility entry point
if __name__ == '__main__':
    from ambuild2 import run
    run.Main()
