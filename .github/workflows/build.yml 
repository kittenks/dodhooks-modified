name: build
on:
  push:
    branches: [master, main, sm-1.12]
    tags: ["v*"]
  pull_request:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: ubuntu-22.04
            arch: x86
            cc: clang
            cxx: clang++
          - os: ubuntu-22.04
            arch: x86_64
            cc: clang
            cxx: clang++
          - os: windows-2022
            arch: x86
            msvc_arch: x86
          - os: windows-2022
            arch: x86_64
            msvc_arch: x64

    runs-on: ${{ matrix.os }}
    name: ${{ matrix.os }} / ${{ matrix.arch }}

    steps:
      - name: Checkout dodhooks
        uses: actions/checkout@v4
        with:
          submodules: recursive
          path: src

      - name: Checkout SourceMod
        uses: actions/checkout@v4
        with:
          repository: alliedmodders/sourcemod
          ref: 1.12-dev
          path: sourcemod
      - name: SourceMod submodules
        run: git -C sourcemod submodule update --init --recursive

      - name: Checkout MM:S
        uses: actions/checkout@v4
        with:
          repository: alliedmodders/metamod-source
          ref: 1.11-dev
          path: mmsource

      - name: Checkout hl2sdk-dod
        uses: actions/checkout@v4
        with:
          repository: alliedmodders/hl2sdk
          ref: dod
          path: hl2sdk-dod

      - name: Checkout AMBuild
        uses: actions/checkout@v4
        with:
          repository: alliedmodders/ambuild
          path: ambuild

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.x"

      - name: Install AMBuild (Linux)
        if: runner.os == 'Linux'
        run: sudo pip install ./ambuild
      - name: Install AMBuild (Windows)
        if: runner.os == 'Windows'
        run: pip install ./ambuild

      - name: Install multilib toolchain (Linux x86)
        if: runner.os == 'Linux' && matrix.arch == 'x86'
        run: |
          sudo dpkg --add-architecture i386
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            gcc-multilib g++-multilib lib32stdc++6 \
            zlib1g-dev zlib1g-dev:i386 libc6-dev-i386 linux-libc-dev:i386

      - name: Install clang (Linux x86_64)
        if: runner.os == 'Linux' && matrix.arch == 'x86_64'
        run: sudo apt-get install -y clang

      - name: Setup MSVC (x86)
        if: runner.os == 'Windows' && matrix.msvc_arch == 'x86'
        uses: ilammy/msvc-dev-cmd@v1
        with:
          arch: x86
      - name: Setup MSVC (x64)
        if: runner.os == 'Windows' && matrix.msvc_arch == 'x64'
        uses: ilammy/msvc-dev-cmd@v1
        with:
          arch: x64

      - name: Configure (Linux)
        if: runner.os == 'Linux'
        working-directory: src
        env:
          CC: ${{ matrix.cc }}
          CXX: ${{ matrix.cxx }}
        run: |
          mkdir build && cd build
          python3 ../configure.py \
            --targets=${{ matrix.arch }} \
            --enable-optimize \
            --sm-path=$GITHUB_WORKSPACE/sourcemod \
            --mms-path=$GITHUB_WORKSPACE/mmsource \
            --hl2sdk-root=$GITHUB_WORKSPACE \
            --sdks=dod

      - name: Configure (Windows)
        if: runner.os == 'Windows'
        working-directory: src
        shell: cmd
        run: |
          mkdir build && cd build
          py ../configure.py ^
            --targets=${{ matrix.arch }} ^
            --enable-optimize ^
            --sm-path=%GITHUB_WORKSPACE%/sourcemod ^
            --mms-path=%GITHUB_WORKSPACE%/mmsource ^
            --hl2sdk-root=%GITHUB_WORKSPACE% ^
            --sdks=dod

      - name: Build
        working-directory: src/build
        run: ambuild

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: dodhooks-${{ runner.os }}-${{ matrix.arch }}
          path: src/build/objdir/package/*
          if-no-files-found: error

  release:
    needs: build
    if: startsWith(github.ref, 'refs/tags/v')
    runs-on: ubuntu-22.04
    steps:
      - uses: actions/download-artifact@v4
        with:
          path: artifacts
      - name: Zip per target
        run: |
          cd artifacts
          for d in dodhooks-*; do zip -r "../$d.zip" "$d"; done
          cd ..
      - uses: softprops/action-gh-release@v2
        with:
          files: dodhooks-*.zip
