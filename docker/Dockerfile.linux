# DoDHooks - Docker Build Environment (Linux)
# Supports both x86 (32-bit) and x86_64 (64-bit) builds
#
# Usage:
#   docker build -f Dockerfile.linux -t dodhooks-builder .
#   docker run --rm -v $(pwd):/output dodhooks-builder

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Install base dependencies
RUN apt-get update && apt-get install -y \
    software-properties-common \
    curl \
    wget \
    git \
    python3 \
    python3-pip \
    python-is-python3 \
    zip \
    unzip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install 32-bit and 64-bit compilers
RUN apt-get update && apt-get install -y \
    gcc-9 \
    g++-9 \
    gcc-9-multilib \
    g++-9-multilib \
    gcc-9-i686-linux-gnu \
    g++-9-i686-linux-gnu \
    && rm -rf /var/lib/apt/lists/*

# Install 32-bit libraries for x86 builds
RUN dpkg --add-architecture i386 && apt-get update && apt-get install -y \
    lib32stdc++6 \
    lib32z1-dev \
    libc6-dev-i386 \
    linux-libc-dev:i386 \
    && rm -rf /var/lib/apt/lists/*

# Install Clang (for newer SourceMod versions)
RUN wget -qO- https://apt.llvm.org/llvm-snapshot.gpg.key | tee /etc/apt/trusted.gpg.d/llvm.asc
RUN add-apt-repository -y "deb http://apt.llvm.org/jammy/ llvm-toolchain-jammy-16 main" 2>/dev/null || true
RUN apt-get update && apt-get install -y \
    clang-16 \
    lld-16 \
    libc++-16-dev \
    libc++abi-16-dev \
    && rm -rf /var/lib/apt/lists/* || true

# Install AMBuild
RUN pip3 install --upgrade pip && pip3 install ambuild

# Set up build environment
WORKDIR /build

# Clone dependencies
RUN git clone --depth 1 --branch 1.12-dev https://github.com/alliedmodders/sourcemod.git
RUN git clone --depth 1 --branch 1.12-dev https://github.com/alliedmodders/metamod-source.git
RUN git clone --depth 1 --branch master https://github.com/alliedmodders/hl2sdk.git hl2sdk-dods

# Copy DoDHooks source
COPY . /build/dodhooks

# Build script for x86
RUN echo '#!/bin/bash\n\
set -e\n\
cd /build/dodhooks\n\
mkdir -p build-x86\n\
cd build-x86\n\
CC=gcc-9 CXX=g++-9 python3 ../configure.py \\\n\
    --sm-path=/build/sourcemod \\\n\
    --mms-path=/build/metamod-source \\\n\
    --hl2sdk-root=/build \\\n\
    --enable-optimize \\\n\
    --targets=x86\n\
ambuild\n\
echo "x86 build complete"\n' > /build/build-x86.sh

# Build script for x86_64
RUN echo '#!/bin/bash\n\
set -e\n\
cd /build/dodhooks\n\
mkdir -p build-x64\n\
cd build-x64\n\
CC=gcc-9 CXX=g++-9 python3 ../configure.py \\\n\
    --sm-path=/build/sourcemod \\\n\
    --mms-path=/build/metamod-source \\\n\
    --hl2sdk-root=/build \\\n\
    --enable-optimize \\\n\
    --targets=x86_64\n\
ambuild\n\
echo "x86_64 build complete"\n' > /build/build-x64.sh

RUN chmod +x /build/build-x86.sh /build/build-x64.sh

# Package script
RUN echo '#!/bin/bash\n\
set -e\n\
BUILD_DIR="/build/dodhooks"\n\
OUTPUT_DIR="/output"\nmkdir -p "$OUTPUT_DIR"\n\
\n\
# Package x86\n\
if [ -d "$BUILD_DIR/build-x86/package" ]; then\n\
    cd "$BUILD_DIR/build-x86/package"\n\
    zip -r "$OUTPUT_DIR/dodhooks-linux-x86.zip" .\n\
    echo "Packaged: dodhooks-linux-x86.zip"\n\
fi\n\
\n\
# Package x86_64\n\
if [ -d "$BUILD_DIR/build-x64/package" ]; then\n\
    cd "$BUILD_DIR/build-x64/package"\n\
    zip -r "$OUTPUT_DIR/dodhooks-linux-x86_64.zip" .\n\
    echo "Packaged: dodhooks-linux-x86_64.zip"\n\
fi\n' > /build/package.sh

RUN chmod +x /build/package.sh

# Default command: build both architectures
CMD ["/bin/bash", "-c", "\
    echo '=== Building DoDHooks for Linux x86 ===' && \
    /build/build-x86.sh && \
    echo '' && \
    echo '=== Building DoDHooks for Linux x86_64 ===' && \
    /build/build-x64.sh && \
    echo '' && \
    echo '=== Packaging ===' && \
    /build/package.sh && \
    echo '' && \
    echo '=== Build Complete ===' && \
    ls -la /output/"]
