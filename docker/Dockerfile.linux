# DoDHooks Docker Build Environment
# 用法:
#   docker build -f docker/Dockerfile.linux -t dodhooks-build .
#   docker run --rm -v $(pwd):/workspace dodhooks-build

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

# 基础工具
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    wget \
    curl \
    build-essential \
    gcc \
    g++ \
    clang \
    libc6-dev \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Python 3.11 (PPA)
RUN apt-get update && apt-get install -y --no-install-recommends software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa -y \
    && apt-get update && apt-get install -y --no-install-recommends python3.11 python3.11-venv python3.11-dev \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python3 \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python \
    && rm -rf /var/lib/apt/lists/*

# AMBuild 2.2.0
RUN pip3 install --break-system-packages "AMBuild==2.2.0"

# 32 位支持 (multilib)
RUN dpkg --add-architecture i386 \
    && apt-get update && apt-get install -y --no-install-recommends \
    gcc-multilib \
    g++-multilib \
    lib32stdc++6 \
    zlib1g-dev \
    zlib1g-dev:i386 \
    libc6-dev-i386 \
    linux-libc-dev:i386 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# 编译脚本入口
COPY scripts/docker-build.sh /docker-build.sh
RUN chmod +x /docker-build.sh

CMD ["/docker-build.sh"]
