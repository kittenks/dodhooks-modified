# DoDHooks - Docker Build Environment (Windows cross-compile via MinGW-w64)
# 
# Note: For best results, build Windows binaries natively on Windows
# using the GitHub Actions workflow. This Dockerfile provides an
# alternative using MinGW-w64 cross-compilation.
#
# Usage:
#   docker build -f Dockerfile.windows -t dodhooks-windows .
#   docker run --rm -v $(pwd):/output dodhooks-windows

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Install base dependencies
RUN apt-get update && apt-get install -y \
    software-properties-common \
    curl \
    wget \
    git \
    python3 \
    python3-pip \
    python-is-python3 \
    zip \
    unzip \
    ca-certificates \
    cmake \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

# Install MinGW-w64 for cross-compilation
RUN apt-get update && apt-get install -y \
    mingw-w64 \
    gcc-mingw-w64-i686 \
    g++-mingw-w64-i686 \
    gcc-mingw-w64-x86-64 \
    g++-mingw-w64-x86-64 \
    && rm -rf /var/lib/apt/lists/*

# Install 32-bit Linux tools (for comparison builds)
RUN dpkg --add-architecture i386 && apt-get update && apt-get install -y \
    gcc-9-multilib \
    g++-9-multilib \
    lib32stdc++6 \
    && rm -rf /var/lib/apt/lists/*

# Install AMBuild
RUN pip3 install --upgrade pip && pip3 install ambuild

WORKDIR /build

# Clone dependencies
RUN git clone --depth 1 --branch 1.12-dev https://github.com/alliedmodders/sourcemod.git
RUN git clone --depth 1 --branch 1.12-dev https://github.com/alliedmodders/metamod-source.git
RUN git clone --depth 1 --branch master https://github.com/alliedmodders/hl2sdk.git hl2sdk-dods

# Copy DoDHooks source
COPY . /build/dodhooks

# Note: Full Windows cross-compilation with AMBuild requires
# additional setup. For production Windows builds, use:
# - GitHub Actions (recommended)
# - Native Windows with Visual Studio 2019/2022
# - WINE + Visual Studio Build Tools

# This Dockerfile primarily serves as a reference
# The recommended approach is GitHub Actions for Windows builds

# Build script for Linux x86 (can run in this container)
RUN echo '#!/bin/bash\nset -e\n\
cd /build/dodhooks\n\
mkdir -p build-x86\n\
cd build-x86\n\
CC=gcc-9 CXX=g++-9 python3 ../configure.py \\\n\
    --sm-path=/build/sourcemod \\\n\
    --mms-path=/build/metamod-source \\\n\
    --hl2sdk-root=/build \\\n\
    --enable-optimize \\\n\
    --targets=x86\n\
ambuild\n' > /build/build-linux-x86.sh

# Build script for Linux x86_64
RUN echo '#!/bin/bash\nset -e\n\
cd /build/dodhooks\n\
mkdir -p build-x64\n\
cd build-x64\n\
CC=gcc-9 CXX=g++-9 python3 ../configure.py \\\n\
    --sm-path=/build/sourcemod \\\n\
    --mms-path=/build/metamod-source \\\n\
    --hl2sdk-root=/build \\\n\
    --enable-optimize \\\n\
    --targets=x86_64\n\
ambuild\n' > /build/build-linux-x64.sh

RUN chmod +x /build/build-linux-x86.sh /build/build-linux-x64.sh

# Package script
RUN echo '#!/bin/bash\nset -e\n\
OUTPUT_DIR="/output"\nmkdir -p "$OUTPUT_DIR"\n\
\n\
# Package Linux x86\n\
if [ -d "/build/dodhooks/build-x86/package" ]; then\n\
    cd "/build/dodhooks/build-x86/package"\n\
    zip -r "$OUTPUT_DIR/dodhooks-linux-x86.zip" .\n\
fi\n\
\n\
# Package Linux x86_64\n\
if [ -d "/build/dodhooks/build-x64/package" ]; then\n\
    cd "/build/dodhooks/build-x64/package"\n\
    zip -r "$OUTPUT_DIR/dodhooks-linux-x86_64.zip" .\n\
fi\n\
\necho "Done! Output files:"\n\
ls -la "$OUTPUT_DIR/"\n' > /build/package.sh

RUN chmod +x /build/package.sh

CMD ["/bin/bash", "-c", "\
    echo '=== Building DoDHooks (Linux x86 + x86_64) ===' && \
    /build/build-linux-x86.sh && \
    echo '' && \
    /build/build-linux-x64.sh && \
    echo '' && \
    echo '=== Packaging ===' && \
    /build/package.sh"]
